@using WebApplicationInAspire.Services
@model WebApplicationInAspire.Models.Entities.Need
@{ViewData["Title"]="Bekreft statusendring"; var status=ViewData["NewStatus"]?.ToString()??"UnderReview";}
<div class="form-page"><a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Til behovet</a><header class="page-heading"><div><h1>Bekreft statusendring</h1><p>@Model.Type i @Model.Region</p></div></header><div class="panel"><p>Status endres fra <strong>@PortalDisplay.Status(Model.Status)</strong> til <strong>@PortalDisplay.Status(status)</strong>.</p>@if(status=="Resolved"){<p>Behovet avsluttes uten tildeling av en ressurs. Du kan gjenåpne behovet senere.</p>}<form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="needVersion" value="@Model.Version"/><input type="hidden" name="status" value="@status"/><div class="form-actions"><button type="submit" class="btn btn-primary">Bekreft statusendring</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Avbryt</a></div></form></div></div>
