@{ViewData["Title"]="Tildelingen ble ikke gjennomført";}
<div class="panel empty-state"><p class="eyebrow">OPPDATERT SITUASJON</p><h1>Tildelingen kunne ikke gjennomføres</h1><p>Ressursen eller behovet er endret siden du åpnet siden. Ingen delvis tildeling er lagret. Oppdater oversikten og kontroller status før du prøver igjen.</p>@if(ViewData["NeedId"] is int id){<a asp-action="Details" asp-route-id="@id" class="btn btn-primary">Se oppdatert behov</a><a asp-action="Matches" asp-route-id="@id" class="btn btn-secondary">Finn ledige ressurser</a>}else{<a asp-action="Overview" class="btn btn-primary">Til behov og tildelinger</a>}</div>
