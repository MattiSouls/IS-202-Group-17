@using System.Security.Claims
@using WebApplicationInAspire.Models.Entities
@using WebApplicationInAspire.Services
@model Need
@{ViewData["Title"]="Behov: "+Model.Type; var canManage=Model.CreatedByUserId==User.FindFirstValue(ClaimTypes.NameIdentifier)||User.IsInRole("Admin");}
@{ var returnUrl = Context.Request.Query["returnUrl"].ToString(); var backUrl = Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Overview"); }
<a href="@backUrl" class="back-link">← Behov og tildelinger</a>
<header class="page-heading"><div><p class="eyebrow">BEHOV #@Model.Id / @Model.Region</p><h1>@Model.Type</h1><p><span class="status-pill @(Model.Status=="Assigned"?"blue":Model.Status=="Resolved"?"green":"amber")">@PortalDisplay.Status(Model.Status)</span> <span class="muted">· Prioritet: @PortalDisplay.Priority(Model.Priority)</span></p></div>
@if(canManage && Model.Status is "New" or "UnderReview"){<div class="actions"><a asp-action="Matches" asp-route-id="@Model.Id" class="btn btn-primary">Finn passende ressurser →</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Rediger behov</a></div>}</header>
<ol class="steps" aria-label="Behovets status">@foreach(var status in new[]{"New","UnderReview","Assigned","Resolved"}){<li aria-current="@(status==Model.Status?"step":null)">@PortalDisplay.Status(status)</li>}</ol>
<div class="detail-grid"><section class="panel"><h2>Hva, hvor og når</h2><dl class="detail-list mt-4"><div><dt>Kategori</dt><dd>@Model.Type</dd></div><div><dt>Region</dt><dd>@Model.Region</dd></div><div><dt>Tidspunkt (norsk tid)</dt><dd>@Model.NeededAt.ToString("dd.MM.yyyy HH:mm")</dd></div><div><dt>Sted</dt><dd>@(Model.Location??"Ikke oppgitt")</dd></div><div><dt>Kontaktperson</dt><dd>@Model.ContactName</dd></div><div><dt>Telefon</dt><dd><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></dd></div>
@if(Model.Latitude.HasValue&&Model.Longitude.HasValue){<div class="wide"><dt>Kartpunkt for avstandssortering</dt><dd>@Model.Latitude.Value.ToString("F5"), @Model.Longitude.Value.ToString("F5")</dd></div>}</dl></section>
<aside class="panel">
@if(Model.Status==NeedStatuses.Assigned && Model.AssignedResource is {} resource){<p class="eyebrow">TILDELT RESSURS</p><h2>@resource.Name</h2><p class="muted">@resource.ContactName · <a href="tel:@resource.PhoneNumber">@resource.PhoneNumber</a></p><p>Leverandøren har fått et varsel. Avtal kapasitet, oppmøte og transport direkte.</p>
@if(canManage){<div class="task-list"><a asp-action="Review" asp-route-id="@Model.Id" asp-route-operation="resolve" class="btn btn-primary">Løs behov og frigi ressurs</a><a asp-action="Review" asp-route-id="@Model.Id" asp-route-operation="release" class="btn btn-secondary">Frigi ressurs, behold behov</a></div>}}
else if(Model.Status==NeedStatuses.Resolved){<h2>Behovet er løst</h2><p class="muted">Ingen ressurs er låst til dette behovet.</p>@if(canManage){<form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="needVersion" value="@Model.Version"/><input type="hidden" name="status" value="New"/><button class="btn btn-secondary" type="submit">Gjenåpne behov</button></form>}}
else{<h2>Neste steg</h2><p class="muted">Finn tilbud med samme kategori og region, og et tidsrom som dekker behovets tidspunkt.</p><a asp-action="Matches" asp-route-id="@Model.Id" class="btn btn-primary">Se passende ressurser</a>@if(canManage){<div class="actions mt-3"><a asp-action="ReviewStatus" asp-route-id="@Model.Id" asp-route-status="UnderReview" class="btn btn-secondary btn-sm">Sett til vurdering</a><a asp-action="ReviewStatus" asp-route-id="@Model.Id" asp-route-status="Resolved" class="btn btn-secondary btn-sm">Avslutt uten tildeling</a></div>}@if(!canManage){<p class="form-text mt-3">Oppretteren av behovet eller administrator må bekrefte tildelingen.</p>}}</aside></div>

@if(ViewData["History"] is IReadOnlyList<AllocationEvent> history && history.Count>0){<section class="panel mt-4"><h2>Tildelingshistorikk</h2><p class="form-text">De siste 30 hendelsene for dette behovet. Historikken beholdes når en ressurs frigis.</p>@foreach(var entry in history){<article class="task-item"><div><h3>@(entry.Action=="Assigned"?"Tildelt":entry.Action=="Released"?"Frigitt":"Behov løst") · @entry.ResourceName</h3></div><time>@TimeZoneInfo.ConvertTimeFromUtc(entry.CreatedAtUtc,TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo")).ToString("dd.MM.yyyy HH:mm")</time></article>}</section>}
