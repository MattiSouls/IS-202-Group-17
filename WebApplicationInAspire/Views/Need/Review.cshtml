@model WebApplicationInAspire.Models.AssignmentReview
@{var assign=Model.Action=="assign"; var resolve=Model.Action=="resolve"; ViewData["Title"]=assign?"Bekreft tildeling":resolve?"Avslutt behovet":"Frigi ressurs";}
<div class="form-page"><a asp-action="Details" asp-route-id="@Model.Need.Id" class="back-link">← Til behovet</a><header class="page-heading"><div><p class="eyebrow">KONTROLLER FØR DU BEKREFTER</p><h1>@ViewData["Title"]</h1><p>@(assign?"Sjekk at dette er riktig ressurs for behovet.":resolve?"Behovet settes til Løst og ressursen blir ledig igjen.":"Ressursen blir ledig igjen. Behovet beholdes med status Vurderes.")</p></div></header>
<div class="panel"><dl class="detail-list"><div><dt>Behov</dt><dd>@Model.Need.Type i @Model.Need.Region</dd></div><div><dt>Tidspunkt (norsk tid)</dt><dd>@Model.Need.NeededAt.ToString("dd.MM.yyyy HH:mm")</dd></div><div><dt>Ressurs</dt><dd>@Model.Resource.Name</dd></div><div><dt>Leverandørkontakt</dt><dd>@Model.Resource.ContactName · @Model.Resource.PhoneNumber</dd></div><div class="wide"><dt>Tilbudets tidsrom</dt><dd><partial name="_ResourcePeriod" model="Model.Resource"/></dd></div></dl>
<p class="form-help mt-4">@(assign?"Ressursen sperres for andre tildelinger. Leverandøren får et varsel med behovet og kontaktinformasjonen. Avtal praktisk bruk direkte.":"Leverandøren får et varsel om at ressursen er frigitt. Avtal eventuelt videre oppfølging direkte.")</p>
<form asp-action="@(assign?"Assign":resolve?"UpdateStatus":"Release")" method="post"><input type="hidden" name="id" value="@Model.Need.Id"/><input type="hidden" name="needVersion" value="@Model.Need.Version"/><input type="hidden" name="resourceVersion" value="@Model.Resource.Version"/><input type="hidden" name="resourceId" value="@Model.Resource.Id"/>@if(resolve){<input type="hidden" name="status" value="Resolved"/>}<div class="form-actions"><button type="submit" class="btn btn-primary">@(assign?"Bekreft tildeling":resolve?"Bekreft: løs behov og frigi":"Bekreft frigivelse")</button><a asp-action="Details" asp-route-id="@Model.Need.Id" class="btn btn-secondary">Avbryt</a></div></form></div></div>
