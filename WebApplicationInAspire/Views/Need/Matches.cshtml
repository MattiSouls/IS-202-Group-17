@using WebApplicationInAspire.Models
@using WebApplicationInAspire.Models.Entities
@using WebApplicationInAspire.Services
@model NeedMatchesViewModel
@{ViewData["Title"]="Finn passende ressurser"; var need=Model.Need;}
<a asp-action="Details" asp-route-id="@need.Id" class="back-link">← Til behovet</a>
<header class="page-heading"><div><p class="eyebrow">MATCHING / BEHOV #@need.Id</p><h1>Ressurser til @need.Type.ToLower()</h1><p>Treffene oppfyller alle kriteriene under. Du kontrollerer detaljene før du tildeler.</p></div></header>
<div class="match-criteria"><span class="criterion">Kategori <strong>@need.Type</strong></span><span class="criterion">Region <strong>@need.Region</strong></span><span class="criterion">Tidspunkt <strong>@need.NeededAt.ToString("dd.MM.yyyy HH:mm")</strong></span></div>
@if(!MatchingRules.CanAssign(need)){<div class="feedback warning">Dette behovet er @PortalDisplay.Status(need.Status). <a asp-action="Details" asp-route-id="@need.Id">Åpne behovet for å frigi eller gjenåpne det.</a></div>}
else if(Model.Total==0){<div class="panel empty-state"><h2>Ingen ledige tilbud oppfyller alle kriteriene</h2><p>Kontroller kategori, region og tidspunkt. En ressurs må være tilbudt av eieren, dekke tidspunktet og ikke være tildelt et annet behov.</p>@if(Model.CanManage){<a asp-action="Edit" asp-route-id="@need.Id" class="btn btn-primary">Kontroller og rediger behov</a>}<a asp-controller="Resource" asp-action="Overview" class="btn btn-secondary">Se alle tilbud</a></div>}
else{
<div class="list-meta"><span><strong>@Model.Total</strong> passende @(Model.Total==1?"ressurs":"ressurser")</span><span>@(need.Latitude.HasValue&&need.Longitude.HasValue?"Nærmeste først · luftlinje, ikke reisetid":"Sortert etter ressursnavn")</span></div>
<div class="match-list">@foreach(var resource in Model.Resources){<article class="panel match-card"><div><h2>@resource.Name</h2><p>@resource.Description</p><p><partial name="_ResourcePeriod" model="resource"/> · Norsk tid</p><div class="match-reasons"><span>✓ Samme kategori</span><span>✓ Samme region</span><span>✓ Dekker tidspunktet</span><span>✓ Ledig for tildeling</span></div>@if(need.Latitude is double lat&&need.Longitude is double lng){<p class="mt-2"><strong>@PortalDisplay.Distance(lat,lng,resource.Latitude,resource.Longitude).ToString("F1") km</strong> luftlinje</p>}</div>
@if(Model.CanManage){<a asp-action="Review" asp-route-id="@need.Id" asp-route-resourceId="@resource.Id" class="btn btn-primary" aria-label="Vurder tildeling av @resource.Name">Vurder tildeling →</a>}else{<span class="muted">Oppretter/admin kan tildele</span>}</article>}</div>
<partial name="_Paging" model="@(new Paging(Model.Page,Model.Total,"Need","Matches",new Dictionary<string,string>{["id"]=need.Id.ToString()}))"/>
}
