@using System.Security.Claims
@using WebApplicationInAspire.Models.Entities
@using WebApplicationInAspire.Security
@model IReadOnlyList<Need>

@{
    ViewData["Title"] = "Registrerte behov";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var statuses = new Dictionary<string, string>
    {
        [NeedStatuses.New] = "Ny", [NeedStatuses.UnderReview] = "Vurderes",
        [NeedStatuses.Assigned] = "Tildelt", [NeedStatuses.Resolved] = "Løst"
    };
    var priorities = new Dictionary<string, string>
    {
        ["Low"] = "Lav", ["Medium"] = "Middels", ["High"] = "Høy", ["Urgent"] = "Haster"
    };
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2>Registrerte behov</h2>
        <a asp-action="Register" class="btn btn-primary">Registrer nytt behov</a>
    </div>
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (Model.Count == 0)
    {
        <p>Det er ikke registrert noen behov ennå.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var need in Model)
            {
                <div class="col-12 col-lg-6">
                    <article class="card h-100">
                        <div class="card-body">
                            <h3 class="h5">@need.Type</h3>
                            <p><strong>Region:</strong> @need.Region</p>
                            <p><strong>Lokasjon:</strong> @need.Location</p>
                            <p><strong>Tidspunkt:</strong> @need.NeededAt.ToString("dd.MM.yyyy HH:mm")</p>
                            <p><strong>Prioritet:</strong> @priorities.GetValueOrDefault(need.Priority, need.Priority)</p>
                            <p><strong>Kontaktperson:</strong> @need.ContactName</p>
                            <p><strong>Telefon:</strong> @need.PhoneNumber</p>
                            <p><strong>Status:</strong> @statuses.GetValueOrDefault(need.Status, need.Status)</p>
                            <p><a asp-action="Matches" asp-route-id="@need.Id" class="btn btn-outline-primary">Se ressurser for behovet</a></p>
                            @if (need.CreatedByUserId == userId || User.IsInRole(RoleNames.Admin))
                            {
                                @if (need.Status == NeedStatuses.Assigned)
                                {
                                    <p><strong>Tildelt ressurs:</strong> @need.AssignedResource?.Name</p>
                                    <form asp-action="Release" method="post" class="mb-2">
                                        <input type="hidden" name="id" value="@need.Id" />
                                        <button type="submit" class="btn btn-outline-primary">Frigi ressurs, behold behov</button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@need.Id" />
                                        <input type="hidden" name="status" value="Resolved" />
                                        <button type="submit" class="btn btn-success">Løs behov og frigi ressurs</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@need.Id" />
                                        <label for="status-@need.Id">Endre status:</label>
                                        <select name="status" id="status-@need.Id" class="form-select">
                                            @foreach (var status in statuses.Where(item => item.Key != NeedStatuses.Assigned))
                                            {
                                                <option value="@status.Key" selected="@(status.Key == need.Status)">@status.Value</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary mt-2">Oppdater status</button>
                                    </form>
                                }
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
