@using System.Security.Claims
@using WebApplicationInAspire.Models
@using WebApplicationInAspire.Services
@model NeedListViewModel
@{ ViewData["Title"]="Behov og tildelinger"; var userId=User.FindFirstValue(ClaimTypes.NameIdentifier); var f=Model.Filter; var routes=new Dictionary<string,string> { ["q"]=f.Q??"",["region"]=f.Region??"",["status"]=f.Status??"",["mine"]=f.Mine.ToString() }; }
<header class="page-heading"><div><p class="eyebrow">OFFENTLIG AKTØR</p><h1>Behov og tildelinger</h1><p>Se hva som trengs, finn passende ressurser og følg opp tildelinger.</p></div><div class="actions"><a asp-action="Register" class="btn btn-primary">＋ Registrer behov</a></div></header>
<form method="get" class="panel filter-panel"><div class="filter-grid">
<div><label for="q">Søk i kategori, region eller sted</label><input id="q" name="q" value="@f.Q" maxlength="100" type="search" class="form-control" /></div>
<div><label for="region">Region</label><select name="region" id="region" class="form-select"><option value="">Alle regioner</option>@foreach(var region in Model.Regions){<option value="@region" selected="@(region==f.Region)">@region</option>}</select></div>
<div><label for="status">Status / oppfølging</label><select name="status" id="status" class="form-select"><option value="">Alle statuser</option>@foreach(var item in new[]{("uncovered","Udekkede behov"),("urgent","Udekkede · Haster"),("time-passed","Udekkede · tidspunkt passert")}){<option value="@item.Item1" selected="@(f.Status==item.Item1)">@item.Item2</option>}@foreach(var status in new[]{"New","UnderReview","Assigned","Resolved"}){<option value="@status" selected="@(f.Status==status)">@PortalDisplay.Status(status)</option>}</select></div>
<div class="form-check"><input class="form-check-input" type="checkbox" name="mine" id="mine" value="true" checked="@f.Mine" /><label for="mine">Bare mine behov</label></div>
<div class="actions"><button type="submit" class="btn btn-primary">Søk</button><a asp-action="Overview" class="btn btn-secondary">Nullstill</a></div></div></form>
<p class="status-explanation">Ny og Vurderes er åpne behov. Tildelt betyr at en ressurs er koblet til behovet; Løst betyr at behovet er avsluttet. Prioritet vises separat.</p>
<div class="list-meta"><span><strong>@Model.Total</strong> behov funnet · åpne behov og høy prioritet først, deretter tidspunkt</span></div>
@if(Model.Needs.Count==0){<div class="panel empty-state"><h2>Ingen behov å vise</h2><p>Prøv andre filtre eller registrer et nytt behov.</p><a asp-action="Register" class="btn btn-primary">Registrer behov</a></div>}
else{
<div class="panel table-panel"><table class="resource-table"><caption class="visually-hidden">Behov med tidspunkt, prioritet og status</caption><thead><tr><th scope="col" class="name-cell">Behov / region</th><th scope="col">Tidspunkt</th><th scope="col">Prioritet</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Handling</span></th></tr></thead><tbody>
@foreach(var need in Model.Needs){<tr><td class="name-cell"><h2><a asp-action="Details" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" asp-route-id="@need.Id"><span class="record-id">#@need.Id</span> @need.Type</a></h2><small>@need.Region · @(need.Location??"Sted ikke oppgitt")</small></td><td data-label="Tidspunkt">@need.NeededAt.ToString("dd.MM.yyyy HH:mm")<br/><small>Norsk tid</small></td><td data-label="Prioritet"><span class="priority-badge @PortalDisplay.PriorityClass(need.Priority)">@PortalDisplay.Priority(need.Priority)</span></td><td data-label="Status"><span class="status-pill @(need.Status=="Assigned"?"blue":need.Status=="Resolved"?"green":"amber")">@PortalDisplay.Status(need.Status)</span></td><td><div class="row-actions">@if(MatchingRules.CanAssign(need) && (User.IsInRole("Admin") || need.CreatedByUserId==userId)){<a asp-action="Matches" asp-route-id="@need.Id" class="btn btn-primary btn-sm" aria-label="Finn ressurser til behov @need.Id">Finn ressurs</a>}<a asp-action="Details" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")" asp-route-id="@need.Id" class="btn btn-secondary btn-sm" aria-label="Se behov @need.Id: @need.Type i @need.Region">Se behov →</a></div></td></tr>}
</tbody></table></div><partial name="_Paging" model="@(new Paging(f.Page,Model.Total,"Need","Overview",routes))" />}
