@using WebApplicationInAspire.Models
@model NotificationList
@{ViewData["Title"]="Varsler"; var isPublic=User.IsInRole("PublicUser")||User.IsInRole("Admin");}
<header class="page-heading"><div><p class="eyebrow">OPPFØLGING</p><h1>Varsler <span class="status-pill">@Model.Unread uleste</span></h1><p>Beskjeder om ressursene og behovene dine. Varslene beholdes når du logger ut.</p></div>@if(Model.Unread>0){<form asp-action="ReadAll" method="post"><button type="submit" class="btn btn-secondary">Marker alle som lest</button></form>}</header>
@if(Model.Items.Count==0){<div class="panel empty-state"><h2>Ingen varsler ennå</h2><p>Du får et varsel når en ressurs blir tildelt eller frigitt.</p></div>}
else{@foreach(var notice in Model.Items){<article class="notice-row @(notice.ReadAtUtc==null?"unread":"")"><div class="panel-heading"><h2>@notice.Title @if(notice.ReadAtUtc==null){<span class="status-pill green">Ulest</span>}</h2><time datetime="@notice.CreatedAtUtc.ToString("o")">@TimeZoneInfo.ConvertTimeFromUtc(notice.CreatedAtUtc,TimeZoneInfo.FindSystemTimeZoneById("Europe/Oslo")).ToString("dd.MM.yyyy HH:mm")</time></div><p>@notice.Message</p><div class="actions">@if(isPublic&&notice.NeedId.HasValue){<a asp-controller="Need" asp-action="Details" asp-route-id="@notice.NeedId" class="btn btn-secondary btn-sm">Åpne behov →</a>}else if(notice.ResourceId.HasValue){<a asp-controller="Resource" asp-action="Details" asp-route-id="@notice.ResourceId" class="btn btn-secondary btn-sm">Åpne ressurs →</a>}
@if(notice.ReadAtUtc==null){<form asp-action="Read" method="post"><input type="hidden" name="id" value="@notice.Id"/><button type="submit" class="btn btn-secondary btn-sm">Marker som lest</button></form>}</div></article>}
<partial name="_Paging" model="@(new Paging(Model.Page,Model.Total,"Notifications","Index",new Dictionary<string,string>(),20))"/>}
