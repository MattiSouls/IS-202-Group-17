@using System.Security.Claims
@using WebApplicationInAspire.Services
@model WebApplicationInAspire.Models.AssignmentInfo
@{ ViewData["Title"] = Model.Resource.Name; var resource=Model.Resource; var owner=resource.OwnerId==User.FindFirstValue(ClaimTypes.NameIdentifier)||User.IsInRole("Admin"); }
@{ var returnUrl = Context.Request.Query["returnUrl"].ToString(); var backUrl = Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Overview"); }
<a href="@backUrl" class="back-link">← Til ressursoversikten</a>
<header class="page-heading"><div><p class="eyebrow">@resource.Type / @resource.Region</p><h1>@resource.Name</h1><p><span class="status-pill @(Model.Need != null ? "blue" : "green")">@PortalDisplay.Availability(resource, Model.Need != null)</span></p></div>
@if (owner && Model.Need == null) { <div class="actions"><a asp-action="Edit" asp-route-id="@resource.Id" class="btn btn-primary">Rediger</a><a asp-action="Delete" asp-route-id="@resource.Id" class="btn btn-outline-danger">Slett</a></div> }</header>
@if(ViewData["AssignmentWarning"] is string warning){<div class="feedback danger" role="alert">@warning</div>}
<div class="detail-grid"><section class="panel"><h2>Om ressursen</h2><p class="muted">@(string.IsNullOrWhiteSpace(resource.Description) ? "Ingen ytterligere beskrivelse er oppgitt." : resource.Description)</p><dl class="detail-list"><div><dt>Kategori</dt><dd>@resource.Type</dd></div><div><dt>Region</dt><dd>@resource.Region</dd></div><div class="wide"><dt>Tidsrom (norsk tid)</dt><dd><partial name="_ResourcePeriod" model="resource" /></dd></div><div><dt>Kontaktperson</dt><dd>@resource.ContactName</dd></div><div><dt>Telefonnummer</dt><dd><a href="tel:@resource.PhoneNumber">@resource.PhoneNumber</a></dd></div><div class="wide"><dt>Koordinater</dt><dd>@resource.Latitude.ToString("F5"), @resource.Longitude.ToString("F5")</dd></div></dl></section>
<aside class="panel">@if (Model.Need is { } need) { <p class="eyebrow">AKTIV TILDELING</p><h2>@need.Type i @need.Region</h2><p>Behovet gjelder @need.NeededAt.ToString("dd.MM.yyyy HH:mm"). Avtal den praktiske bruken med kontaktpersonen.</p><dl class="detail-list"><div><dt>Kontaktperson</dt><dd>@need.ContactName</dd></div><div><dt>Telefon</dt><dd><a href="tel:@need.PhoneNumber">@need.PhoneNumber</a></dd></div><div class="wide"><dt>Sted</dt><dd>@(need.Location ?? "Ikke oppgitt")</dd></div></dl>@if(MatchingRules.Area(need) is {} selectedArea){<partial name="_AreaSummary" model="selectedArea"/>}<p class="form-text mt-3">Den offentlige aktøren må frigi tildelingen før ressursen kan redigeres eller slettes.</p> }
else { <h2>@(owner ? "Hold tilbudet oppdatert" : "Avtal praktisk bruk")</h2><p class="muted">@(owner ? "Du får varsel her i portalen ved tildeling og frigivelse. Pause tilbudet hvis ressursen ikke lenger kan brukes." : "Tilbudet må matches med et registrert behov før det kan tildeles. Kontakt leverandøren om kapasitet og transport.")</p>@if (!owner) { <a asp-controller="Need" asp-action="Overview" class="btn btn-primary">Til behov og matching</a> } }</aside></div>

@section Scripts { <link rel="stylesheet" href="~/lib/leaflet/leaflet.css"/><script src="~/lib/leaflet/leaflet.js"></script><script src="~/js/area-picker.js" asp-append-version="true"></script> }
