@model WebApplicationInAspire.Models.ResourceViewModel

@{
    ViewData["Title"] = "Rediger ressurs";
}

<h2>Rediger ressurs</h2>
@if (ViewData["IsAssigned"] is true)
{
    <div class="alert alert-warning">Ressursen er tildelt. Den offentlige brukeren må frigi den før du kan redigere.</div>
}

<form method="post" asp-controller="Resource" asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <fieldset disabled="@(ViewData["IsAssigned"] is true)">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name">Navn:</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type">Type:</label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Region" class="form-label">Region:</label>
        <input asp-for="Region" class="form-control" />
        <span asp-validation-for="Region" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>
    <div class="mb-3">
        <label asp-for="Description">Beskrivelse:</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactName">Kontaktperson:</label>
        <input asp-for="ContactName" class="form-control" />
        <span asp-validation-for="ContactName"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber">Telefonnummer:</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber"></span>
    </div>

    <div class="mb-3">
        <label>Posisjon (klikk i kartet):</label>
        <div id="map" style="height: clamp(260px, 50vh, 480px); border: 1px solid black;"></div>
    </div>

    <input type="hidden" asp-for="Latitude" id="Latitude" />
    <input type="hidden" asp-for="Longitude" id="Longitude" />
    <span asp-validation-for="Latitude"></span>
    <span asp-validation-for="Longitude"></span>

    <br />
    <button type="submit" class="btn btn-primary">Lagre endringer</button>
    <a asp-action="Overview" class="btn btn-secondary">Avbryt</a>
    </fieldset>
</form>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');
        const latitude = Number(latitudeInput.value);
        const longitude = Number(longitudeInput.value);
        const hasPosition = latitudeInput.value.trim() !== '' && longitudeInput.value.trim() !== ''
            && Number.isFinite(latitude) && Number.isFinite(longitude)
            && Math.abs(latitude) <= 90 && Math.abs(longitude) <= 180;

        // Feltene inneholder lagret posisjon, eller sist innsendte punkt ved valideringsfeil.
        const map = L.map('map').setView(hasPosition ? [latitude, longitude] : [58.1467, 7.9956], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap-bidragsytere'
        }).addTo(map);
        let marker = hasPosition ? L.marker([latitude, longitude]).addTo(map) : null;

        map.on('click', function (event) {
            if (marker) {
                marker.setLatLng(event.latlng);
            } else {
                marker = L.marker(event.latlng).addTo(map);
            }
            latitudeInput.value = event.latlng.lat;
            longitudeInput.value = event.latlng.lng;
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
