@model WebApplicationInAspire.Models.ResourceViewModel

@{
    ViewData["Title"] = "Registrert ressurs";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h1 class="mb-0">Registrert ressurs</h1>
        <!-- Snarvei rett til kartet for mobilbrukere -->
        <a href="#overviewMap" class="btn btn-outline-primary btn-sm">📍 Hopp til kart</a>
    </div>

    <p class="text-muted">Her er informasjonen som ble registrert:</p>

    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="card-title h4 text-primary">@Model.Name</h2>

            <dl class="row mb-0">
                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@Model.Type</dd>

                <dt class="col-sm-4">Beskrivelse</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Kontaktperson</dt>
                <dd class="col-sm-8">@Model.ContactName</dd>

                <dt class="col-sm-4">Telefonnummer</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4">Latitude</dt>
                <dd class="col-sm-8">@Model.Latitude</dd>

                <dt class="col-sm-4">Longitude</dt>
                <dd class="col-sm-8">@Model.Longitude</dd>
            </dl>

        </div>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h4 mb-0">Ressursens plassering</h2>
        <a href="#" class="btn btn-link btn-sm text-decoration-none">⬆ Til toppen</a>
    </div>

    <div id="overviewMap" style="height: 400px; width: 100%; border-radius: 8px; border: 1px solid #dee2e6;"></div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        var latitude = @Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var longitude = @Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var map = L.map('overviewMap').setView([latitude, longitude], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap-bidragsytere'
        }).addTo(map);

        var marker = L.marker([latitude, longitude]).addTo(map);
        marker.bindPopup(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)));
    </script>
}
