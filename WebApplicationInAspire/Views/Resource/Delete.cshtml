@model WebApplicationInAspire.Models.Entities.Resource

@{
    ViewData["Title"] = "Slett ressurs";
}

<h2>Slett ressurs</h2>
@if (ViewData["IsAssigned"] is true)
{ <div class="alert alert-warning" role="alert">@(ViewData["ErrorMessage"] ?? "Ressursen er tildelt og kan ikke slettes før den er frigitt.")</div> }
else { <p>Er du sikker på at du vil slette denne ressursen?</p> }

<div>
    <h4>@Model.Name</h4>
    <p><strong>Type:</strong> @Model.Type</p>
    <p><strong>Kontaktperson:</strong> @Model.ContactName (@Model.PhoneNumber)</p>
</div>

<form method="post" asp-controller="Resource" asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger" disabled="@(ViewData["IsAssigned"] is true)">Bekreft sletting</button>
    <a asp-action="Overview">Avbryt</a>
</form>
