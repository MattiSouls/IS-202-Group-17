@{ ViewData["Title"] = "Start EXPO-demo på nytt"; }
<section class="panel p-4">
    <h1>Klar for neste demonstrasjon?</h1>
    <p>Alle behov, ressurser, varsler og tildelingshistorikk i denne separate EXPO-databasen erstattes med startscenarioet.</p>
    <p>Du får seks ressurser og tre åpne behov for pumpe, aggregat og transport. Tidspunktene settes til i dag, norsk tid. Kontoene og innloggingen beholdes.</p>
    <form asp-action="Reset" method="post">
        <button type="submit" class="btn btn-primary">Nullstill og start neste demonstrasjon</button>
        <a asp-controller="Map" asp-action="Index" class="btn btn-secondary">Avbryt</a>
    </form>
</section>
