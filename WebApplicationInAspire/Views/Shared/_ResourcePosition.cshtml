@model WebApplicationInAspire.Models.ResourceViewModel
<div class="mb-3">
    <p id="position-help">Velg et punkt i kartet, eller skriv inn kjente koordinater dersom kartet ikke virker. Ikke gjett posisjonen.</p>
    <div id="map" style="height: clamp(260px, 50dvh, 480px); width:100%;" class="border rounded" aria-label="Velg ressursens posisjon"></div>
    <p id="map-status" role="status" class="text-secondary mt-2"></p>
    <noscript><p>Kartet krever JavaScript. Du kan fortsatt fylle inn koordinatene under og sende skjemaet.</p></noscript>
</div>
<div class="row">
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Latitude" class="form-label">Breddegrad *</label>
        <input asp-for="Latitude" type="number" step="any" min="-90" max="90" class="form-control" aria-describedby="position-help" />
        <span asp-validation-for="Latitude" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <label asp-for="Longitude" class="form-label">Lengdegrad *</label>
        <input asp-for="Longitude" type="number" step="any" min="-180" max="180" class="form-control" aria-describedby="position-help" />
        <span asp-validation-for="Longitude" class="text-danger"></span>
    </div>
</div>
