@using Microsoft.AspNetCore.Identity
@using WebApplicationInAspire.Security
@inject SignInManager<IdentityUser> SignInManager
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration

<ul class="navbar-nav">
    @if (Environment.IsDevelopment() && Configuration.GetValue<bool>("Demo:Enabled"))
    {
        <li class="nav-item dropdown">
            <button type="button" class="nav-link btn btn-link dropdown-toggle text-dark" data-bs-toggle="dropdown" aria-expanded="false">Vis som</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var role in new[] { (RoleNames.ResourceProvider, "Ressursleverandør"), (RoleNames.PublicUser, "Offentlig bruker"), (RoleNames.Admin, "Administrator") })
                {
                    <li>
                        <form asp-controller="Demo" asp-action="SwitchRole" method="post">
                            <input type="hidden" name="role" value="@role.Item1" />
                            <button type="submit" class="dropdown-item @(User.IsInRole(role.Item1) ? "active" : "")">@role.Item2</button>
                        </form>
                    </li>
                }
            </ul>
        </li>
    }
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">@User.Identity?.Name</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logg ut</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrer</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Logg inn</a>
        </li>
    }
</ul>
