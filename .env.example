# Kopier filen til .env og erstatt begge passordene med egne, lange passord.
MARIADB_DATABASE=resourcesdb
MARIADB_USER=resourcesapp
MARIADB_PASSWORD=replace-with-a-long-local-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-local-password
DB_PORT=3307
WEB_PORT=8080
DEMO_ENABLED=false

# Valgfrie testkontoer, opprettes bare i Development. Fyll ut lokalt i .env.
# Vanlig registrering gir ResourceProvider, ikke offentlig bruker eller administrator.
SEED_PUBLIC_EMAIL=
SEED_PUBLIC_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
